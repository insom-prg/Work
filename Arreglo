Algoritmo Arreglo
  definir n, i, j, aux como entero
  definir original, ordenado como entero 
  escribir "Digite un elemento."
      leer n 
      si n < 1 o n > 30 entonces  
      escribir "Error, el numero que escogio debe de estar entre el 1 y el 30."
      escribir "Digite un elemento." 
      leer n
      fin mientras            
      dimension original[n]
      dimension ordenado[n]
    
      para i <- 1 hasta n con paso 1 hacer
      escribir original[i] <- aleatorio(1,100)
      fin para

      Escribir "Arreglo original"
      para i <- 1 hasta n con paso 1 hacer 
      escribir original[i]
          fin para 

        para i <-  hasta n con paso 1 hacer 
        ordenado [i] <- original[i]
        FinPara

            para i <- hasta n-1 con paso 1 hacer
                para j <- hasta n-1 con paso 1 hacer
                si ordenado[j] > ordenado [j+1] entonces
                aux <- ordenado[j]
                ordenado[j] <- ordenado[j+1]
                ordenado[j+1]<- aux
                FinSi
            finpara
        finpara

        escribir "arreglo ordenado"
        para i<- 1 hasta n con paso 1 hacer
        escribir ordenado[i]
        fin para
        fin algoritmo
        
          
          
    escribir "Arreglo ordenado"
    para i<- hasta n con paso 1 hacer 
    escribir ordenado[1]
    finpara
    FinAlgoritmo
          
          
          
FinAlgoritmo
