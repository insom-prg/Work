Algoritmo OrdenarArreglo
    Definir n, i, j, aux Como Entero
    Definir original, ordenado Como Entero
    
    // Solicitar cantidad con validación
    Escribir 'Ingresa la cantidad de elementos (1 a 30):'
    Leer n
    Mientras n < 1 O n > 30 Hacer
        Escribir 'Error: la cantidad debe estar entre 1 y 30.'
        Escribir 'Ingresa la cantidad de elementos (1 a 30):'
        Leer n
    FinMientras
    
    // Crear los dos arreglos
    Dimension original[n]
    Dimension ordenado[n]
    
    // Llenar solo el arreglo original con aleatorios entre 1 y 100
    Para i <- 1 Hasta n Con Paso 1 Hacer
        original[i] <- Aleatorio(1, 100)
    FinPara
    
    // Mostrar el arreglo original
    Escribir 'Arreglo original:'
    Para i <- 1 Hasta n Con Paso 1 Hacer
        Escribir original[i]
    FinPara
    
    // Llenar el arreglo ordenado copiando el original
    Para i <- 1 Hasta n Con Paso 1 Hacer
        ordenado[i] <- original[i]
    FinPara
    
    // Ordenar solo el segundo arreglo (burbuja, menor a mayor)
    Para i <- 1 Hasta n - 1 Con Paso 1 Hacer
        Para j <- 1 Hasta n - i Con Paso 1 Hacer
            Si ordenado[j] > ordenado[j + 1] Entonces
                aux <- ordenado[j]
                ordenado[j] <- ordenado[j + 1]
                ordenado[j + 1] <- aux
            FinSi
        FinPara
    FinPara
    
    // Mostrar el arreglo ordenado
    Escribir 'Arreglo ordenado:'
    Para i <- 1 Hasta n Con Paso 1 Hacer
        Escribir ordenado[i]
    FinPara
FinAlgoritmo
